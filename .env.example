# Copier vers .env sur la VM et adapter les valeurs.
#   cp .env.example .env && nano .env

# ---- Images publiées (GHCR) ----------------------------------------------
# Tags = releases Git de chaque repo. Bumper ici à chaque nouvelle release.
DB_IMAGE=ghcr.io/pdggrp9/infra-db:0.0.5
WEBAPP_BACKEND_IMAGE=ghcr.io/pdggrp9/webapp-backend:0.0.5
WEBAPP_FRONTEND_IMAGE=ghcr.io/pdggrp9/webapp-frontend:0.2.0

# ---- HTTPS / Caddy -----------------------------------------------------
# Domaine public qui pointe (DNS A/AAAA) vers l'IP de la VM. Caddy obtient
# un certificat Let's Encrypt pour ce nom et sert l'app en https://SITE_DOMAIN.
SITE_DOMAIN=bracelet.example.com
# E-mail pour les notifications d'expiration Let's Encrypt (recommandé).
ACME_EMAIL=admin@example.com

# ---- Base de données ---------------------------------------------------
POSTGRES_DB=bracelet_connecte
POSTGRES_USER=bracelet
POSTGRES_PASSWORD=CHANGE_ME_mot_de_passe_fort
DB_PORT=5432
# 127.0.0.1 = base joignable seulement depuis la VM (via tunnel SSH).
# Mettre 0.0.0.0 pour l'ouvrir publiquement (déconseillé).
DB_BIND=127.0.0.1

# ---- Backend (Django) --------------------------------------------------
DEBUG=false
# Générer une vraie clé : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE_ME_cle_aleatoire_50_caracteres
# Doit contenir le domaine public servi par Caddy.
ALLOWED_HOSTS=bracelet.example.com
# Single-origin (proxy nginx) : inutile pour le navigateur. À renseigner si un
# client externe (app mobile) tape le backend en direct, en https.
CORS_ALLOWED_ORIGINS=https://bracelet.example.com
# TLS terminé par Caddy -> Django doit faire confiance à X-Forwarded-Proto.
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
# HSTS : laisser 0 le temps de valider le certificat, puis 31536000 (1 an).
SECURE_HSTS_SECONDS=0

# ---- Fake emitter (données de démo) ----------------------------------
EMIT_INTERVAL_SECONDS=5
DEVICE_UID=11111111-1111-1111-1111-111111111111
SERIAL_NUMBER=FAKE-BRACELET-001
DISPLAY_NAME=Bracelet de test
